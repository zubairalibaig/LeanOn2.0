# ─────────────────────────────────────────
# LeanOn Environment Variables
# Copy this to .env.local and fill in values
# ─────────────────────────────────────────

# Supabase (get from: supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Agora (get from: console.agora.io → create project → App ID)
NEXT_PUBLIC_AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_CERTIFICATE

# Razorpay (get from: dashboard.razorpay.com → Settings → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# Razorpay webhook secret (get from: dashboard.razorpay.com → Webhooks → your webhook → Secret)
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Resend (get from: resend.com → API Keys)
RESEND_API_KEY=re_YOUR_RESEND_KEY
# Email to receive contact form notifications
ADMIN_NOTIFICATION_EMAIL=hello@leanon.app

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
