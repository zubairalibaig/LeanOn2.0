# ═══════════════════════════════════════════════════════════════
# LeanOn — Required Environment Variables
# Set ALL of these in Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Supabase (supabase.com → project → Settings → API) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # NEVER expose publicly

# ── Razorpay (dashboard.razorpay.com → Settings → API Keys) ────
# ⚠️  REQUIRED for wallet recharge to show and work
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...             # Webhooks → your webhook → Secret

# ── Agora (console.agora.io → project → App ID + App Certificate)
# ⚠️  REQUIRED for voice calls to work
NEXT_PUBLIC_AGORA_APP_ID=...
AGORA_APP_CERTIFICATE=...               # Voice token signing key (server only)

# ── Resend (resend.com → API Keys) ─────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=LeanOn <noreply@leanon.app> # Must use verified domain

# ── Admin ───────────────────────────────────────────────────────
ADMIN_EMAIL=your@email.com              # Admin notifications recipient
ADMIN_SECRET=long-random-string         # Protects /api/admin

# ── Cron ────────────────────────────────────────────────────────
CRON_SECRET=long-random-string          # Vercel cron auth for /api/sessions/cleanup

# ── Analytics (optional) ────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_BING_VERIFICATION=your-key

# ── Local dev only ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
